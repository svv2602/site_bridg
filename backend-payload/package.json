{
  "name": "backend-payload",
  "version": "1.0.0",
  "description": "Bridgestone Ukraine CMS + Content Automation",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "seed": "tsx scripts/seed.ts",
    "generate:types": "payload generate:types",
    "automation": "tsx content-automation/src/scheduler.ts",
    "automation:scrape": "tsx content-automation/src/scheduler.ts scrape",
    "automation:generate": "tsx content-automation/src/scheduler.ts generate",
    "automation:publish": "tsx content-automation/src/scheduler.ts publish",
    "automation:full": "tsx content-automation/src/scheduler.ts run-full",
    "automation:daemon": "tsx content-automation/src/index.ts",
    "automation:image": "tsx content-automation/src/regenerate-image.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "payload",
    "cms",
    "bridgestone"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@ckeditor/ckeditor5-build-classic": "^44.3.0",
    "@ckeditor/ckeditor5-react": "^11.0.1",
    "@payloadcms/db-postgres": "^3.75.0",
    "@payloadcms/next": "^3.75.0",
    "@payloadcms/richtext-lexical": "^3.75.0",
    "@sentry/node": "^10.38.0",
    "@types/jsonwebtoken": "^9.0.10",
    "better-sqlite3": "^12.6.2",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.3",
    "graphql": "^16.12.0",
    "jsonwebtoken": "^9.0.3",
    "next": "^15.5.12",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.1",
    "openai": "^6.16.0",
    "payload": "^3.75.0",
    "playwright": "^1.57.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.0.3",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.9",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@types/sanitize-html": "^2.16.0",
    "@vitest/coverage-v8": "^4.0.16",
    "sass": "^1.89.4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
