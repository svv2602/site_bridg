# Content Automation Environment Variables

# LLM (required for content generation)
ANTHROPIC_API_KEY=sk-ant-...

# Payload CMS (replaces Strapi)
PAYLOAD_URL=http://localhost:3001

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=-100123456789

# Telegram Forum Topics (route to specific threads)
# TELEGRAM_TOPIC_CONTENT=10
# TELEGRAM_TOPIC_ERRORS=4
# TELEGRAM_TOPIC_REPORTS=6

# Scraping settings
SCRAPE_DELAY_MS=2000
