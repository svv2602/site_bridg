# =============================================================================
# Docker Compose Environment Variables
# Copy this file to .env and fill in the values
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=bridgestone
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=bridgestone

# --- Payload CMS (Backend) ---
# REQUIRED: Must be at least 32 characters. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=
# Public URL where the backend is accessible (for CORS, media URLs, etc.)
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3001

# --- Frontend ---
# Public URL for the Payload API (accessible from browser for images, etc.)
NEXT_PUBLIC_PAYLOAD_URL=http://localhost:3001

# --- AI Providers (optional, for content automation) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_AI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Telegram Notifications (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Analytics (optional, baked into frontend JS bundle at build time) ---
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Google Maps (optional, for dealer map) ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
